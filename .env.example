# MeetIntel AI Environment Configuration Template
# Copy this file to .env and provide your specific credentials.
# NEVER commit your actual .env file or production secrets to version control.

# Application Environment Mode
ENV=development
DEMO_MODE=false
ALLOW_OFFLINE_FALLBACK=false
SECRET_KEY=your-32-character-secret-key-for-encryption

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///meetintel.db

# API Key for FastAPI Service Access & CORS
API_KEY=dev-secret-key
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Administrator Account Provisioning (Required in production)
ADMIN_EMAIL=admin@meetintel.ai
ADMIN_PASSWORD=your-secure-admin-password

# Audio Transcription & Whisper
WHISPER_MODEL=small

# Hugging Face (Required for pyannote.audio speaker diarization)
HUGGINGFACE_TOKEN=your-huggingface-token

# Gemini AI Provider (Primary)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=60
GEMINI_BACKOFF_BASE=2
GEMINI_TEMPERATURE=0.7

# OpenAI AI Provider (Alternative / Fallback)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_PRIMARY_PROVIDER=gemini

# Knowledge Base & Vector Store (RAG)
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=storage/vector_db
RAG_TOP_K=5

# Google Workspace Integration (Google Calendar & Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

# Zoom Meetings Integration
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/zoom/oauth/callback

# Email Notification Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@meetintel.ai
