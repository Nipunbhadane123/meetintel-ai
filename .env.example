# Hugging Face (Required for pyannote.audio speaker diarization)
HUGGINGFACE_TOKEN=

# Gemini (Primary AI provider)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-1.5-pro
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=60
GEMINI_BACKOFF_BASE=2
GEMINI_TEMPERATURE=0.7

# OpenAI fallback (Optional alternative AI provider)
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

# Primary provider configuration
AI_PRIMARY_PROVIDER=gemini

# Knowledge Base & RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=storage/vector_db
RAG_TOP_K=5
