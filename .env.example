# Hugging Face (Required for pyannote.audio speaker diarization)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Gemini API Key (Required for AI Insights layer)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-1.5-pro
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=60
GEMINI_BACKOFF_BASE=2
GEMINI_TEMPERATURE=0.7

# OpenAI API Key (Optional alternative AI provider)
OPENAI_API_KEY=your_openai_api_key_here

# Knowledge Base & RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=storage/vector_db
RAG_TOP_K=5
